<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= tituloPagina %></title>
</head>
<body>
  <h1><%= taller.titulo %></h1>
  <p>Categoría: <%= taller.categoria %></p>
  <p>Nivel: <%= taller.nivel %></p>

  <% if (estado === "completo") { %>
    <p>Completo</p>
  <% } else if (estado === "ultima") { %>
    <p>Última plaza disponible</p>
    <p><a href="/talleres/<%= taller.id %>/inscripcion">Inscribirme</a></p>
  <% } else { %>
    <p><%= plazasRestantes %> plazas disponibles</p>
    <p><a href="/talleres/<%= taller.id %>/inscripcion">Inscribirme</a></p>
  <% } %>
</body>
</html>